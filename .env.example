# PolyRoot Agent - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://polyroot:password@localhost:5432/polyroot

# =============================================================================
# WALLET & BLOCKCHAIN (Required)
# =============================================================================
# Private key for Deposit Wallet (Type 3) - NEVER commit this to git!
# Generate via: cast wallet new --keystore or use existing Polymarket deposit wallet
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Wallet address (derived from private key)
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Polygon Mainnet Chain ID
CHAIN_ID=137

# =============================================================================
# RPC ENDPOINTS (Required)
# =============================================================================
# Polygon Mainnet RPC URL - use reliable provider for production
# Free: https://polygon-rpc.com
# Recommended (Alchemy): https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Recommended (Infura): https://polygon-mainnet.infura.io/v3/YOUR_KEY
RPC_URL=https://polygon-rpc.com

# =============================================================================
# RUNTIME MODE (Required)
# =============================================================================
# PAPER | SHADOW | MICRO_LIVE | LIVE
# START WITH PAPER FOR VERIFICATION
RUNTIME_MODE=PAPER

# =============================================================================
# G4 PIPELINE CONFIGURATION
# =============================================================================
# Capital cap for MICRO_LIVE mode (USD)
G4_MICRO_LIVE_CAP_USD=500

# Capital cap in base units (100M = $100 USDC with 6 decimals)
G4_MICRO_LIVE_CAP_BASE=100000000

# Minimum edge after costs for entry (0.03 = 3%)
G4_MIN_EDGE_AFTER_COST=0.03

# Daily loss stop percentage (0.05 = 5%)
G4_DAILY_LOSS_STOP_PCT=0.05

# SHADOW gate criteria (must meet BOTH to pass G5 gate)
G4_SHADOW_MIN_DAYS=30
G4_SHADOW_MIN_CLUSTERS=100

# Paper simulator configuration
G4_PAPER_CANCEL_PROBABILITY=0.05
G4_PAPER_PARTIAL_FRACTION=0.8
G4_PAPER_LATENCY_MS=50
G4_PAPER_MAKER_FEE_BPS=0
G4_PAPER_TAKER_FEE_BPS=200

# =============================================================================
# OBSERVABILITY
# =============================================================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Metrics endpoint port (Prometheus)
METRICS_PORT=9090

# Health check endpoint port
HEALTH_PORT=8080

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES
# =============================================================================
# LLM Provider for Intelligence (if using hosted models)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...

# Alchemy/Infura for enhanced RPC (optional)
# ALCHEMY_API_KEY=...
# INFURA_API_KEY=...

# Slack/Discord webhook for alerts (optional)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# =============================================================================
# DEVELOPMENT OVERRIDES (Optional)
# =============================================================================
# Disable SSL verification for local DB (dev only)
# PGSSLMODE=disable

# Force color output in logs
# FORCE_COLOR=1