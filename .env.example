# PolyRoot Agent - Environment Configuration
# Copy this file to .env and fill in your values.
# Only the variables below are read by the agent; anything else is ignored.
# Setup path: fill DATABASE + WALLET, run `npm start -- wallet verify`,
# then `npm start` (PAPER mode first).

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://polyroot:password@localhost:5432/polyroot

# =============================================================================
# RUNTIME MODE (Required)
# =============================================================================
# PAPER | SHADOW | MICRO_LIVE | LIVE
# START WITH PAPER FOR VERIFICATION
RUNTIME_MODE=PAPER

# KMS key id (optional; only needed if using AWS KMS for signing)
# KMS_KEY_ID=your-kms-key-id

# Encrypted keystore (preferred over raw private key)
# Generate via: polyroot wallet seal --key 0xYOUR_KEY --passphrase "your-passphrase"
# POLYROOT_KEYSTORE_JSON={"v":1,"salt":"...","n":...,"r":...,"p":...,"ciphertext":"...","tag":"..."}
# POLYROOT_KEYSTORE_PASSPHRASE=your-passphrase

# =============================================================================
# WALLET (Private key required; account/funder required for MICRO_LIVE/LIVE)
# =============================================================================
# Private key for Deposit Wallet - NEVER commit this to git!
# Generate via: cast wallet new --keystore or use existing Polymarket deposit wallet
# (PRIVATE_KEY_HEX also accepted; 0x prefix optional)
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Wallet address (derived from the private key above)
# Verify with: npm start -- wallet verify
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Deposit-wallet account & funder (REQUIRED for MICRO_LIVE/LIVE).
# Must be three distinct addresses together with the signer (WAL-03).
WALLET_ACCOUNT=0xYOUR_PROXY_ACCOUNT_HERE
WALLET_FUNDER=0xYOUR_FUNDER_HERE

# Owner loss cap in pUSD (REQUIRED for MICRO_LIVE/LIVE).
# The live order path refuses to submit without it, and a breached cap
# latches entries off until an explicit `polyroot guard reset`.
POLYROOT_MICRO_LIVE_LOSS_CAP_USD=100

# Exposure cap override in USD (optional; default 500, code constant).
# The live order path refuses orders that would push portfolio exposure
# over the cap. Lower it for calibration; raising needs code review.
# POLYROOT_MICRO_LIVE_CAP_USD=500

# Polygon Mainnet Chain ID
CHAIN_ID=137

# =============================================================================
# MARKET UNIVERSE (Required for SHADOW and above; PAPER runs the mock fixture)
# =============================================================================
# Owner-curated CLOB token ids, comma-separated. The loop iterates exactly
# these markets and NEVER falls back to mock data outside PAPER.
# Find token ids via Polymarket gamma API or the market page.
# POLYROOT_MARKET_IDS=106229668102716149832209250222340847662201251266419359322746795373714233470739

# =============================================================================
# KEYSTORE (Recommended: encrypted key at rest instead of raw hex in .env)
# =============================================================================
# Seal once: PRIVATE_KEY_HEX=0x... POLYROOT_KEYSTORE_PASSPHRASE=... npm start -- wallet seal --out /run/secrets/keystore.json
# Then UNSET the raw key and configure only these two. Signer prefers keystore.
# POLYROOT_KEYSTORE_JSON={"v":1,...}
# POLYROOT_KEYSTORE_PASSPHRASE=

# =============================================================================
# VENUE / CLOB API CREDENTIALS (Required for MICRO_LIVE/LIVE)
# =============================================================================
# Polymarket CLOB API credentials - NEVER commit these to git!
# Create at polymarket.com → profile → API credentials.
# Reuse mode: the agent never derives fresh credentials implicitly.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# =============================================================================
# RPC ENDPOINT (Required for SHADOW and above; PAPER runs offline)
# =============================================================================
# Polygon Mainnet RPC URL - use a reliable provider for production
# Free: https://polygon-rpc.com
# Recommended (Alchemy): https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Recommended (Infura): https://polygon-mainnet.infura.io/v3/YOUR_KEY
RPC_URL=https://polygon-rpc.com

# =============================================================================
# FORECAST PROVIDER (Optional — agent abstains/NO_TRADE when unset)
# Any OpenAI-compatible endpoint: OpenAI, 9Router, FreeLLMAPI, Ollama, vLLM.
# =============================================================================
# POLYROOT_FORECAST_PROVIDER=openai
# POLYROOT_FORECAST_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# OBSERVABILITY (Optional — /metrics disabled when the key is unset)
# GET /healthz is always public; GET /metrics requires the Bearer key.
# Serves both endpoints on one port. Docker HEALTHCHECK needs no owner key.
# =============================================================================
# POLYROOT_METRICS_OWNER_KEY=your-owner-key-here
# POLYROOT_METRICS_HOST=127.0.0.1
# POLYROOT_METRICS_PORT=9090

# =============================================================================
# LOGGING (Optional)
# =============================================================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# ADVANCED (Optional — defaults are safe to keep)
# =============================================================================
# Unix socket for the strategy sandbox supervisor
# STRATEGY_RPC_ENDPOINT=unix:///run/strategy/strategy.sock

# Disable SSL verification for local DB (dev only)
# PGSSLMODE=disable

# Force color output in logs
# FORCE_COLOR=1
