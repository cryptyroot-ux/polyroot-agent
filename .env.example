# PolyRoot Agent - Environment Configuration
# Copy this file to .env and fill in your values.
# Only the variables below are read by the agent; anything else is ignored.
# Setup path: fill DATABASE + WALLET, run `npm start -- wallet verify`,
# then `npm start` (PAPER mode first).

# =============================================================================
# DATABASE (Required)
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://polyroot:password@localhost:5432/polyroot

# =============================================================================
# RUNTIME MODE (Required)
# =============================================================================
# PAPER | SHADOW | MICRO_LIVE | LIVE
# START WITH PAPER FOR VERIFICATION
RUNTIME_MODE=PAPER

# KMS key id (required CLI flag today; PAPER accepts any placeholder value)
KMS_KEY_ID=local-dev-key

# =============================================================================
# WALLET (Private key required; account/funder required for MICRO_LIVE/LIVE)
# =============================================================================
# Private key for Deposit Wallet - NEVER commit this to git!
# Generate via: cast wallet new --keystore or use existing Polymarket deposit wallet
# (PRIVATE_KEY_HEX also accepted; 0x prefix optional)
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Wallet address (derived from the private key above)
# Verify with: npm start -- wallet verify
WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# Deposit-wallet account & funder (REQUIRED for MICRO_LIVE/LIVE).
# Must be three distinct addresses together with the signer (WAL-03).
WALLET_ACCOUNT=0xYOUR_PROXY_ACCOUNT_HERE
WALLET_FUNDER=0xYOUR_FUNDER_HERE

# Polygon Mainnet Chain ID
CHAIN_ID=137

# =============================================================================
# RPC ENDPOINT (Required for SHADOW and above; PAPER runs offline)
# =============================================================================
# Polygon Mainnet RPC URL - use a reliable provider for production
# Free: https://polygon-rpc.com
# Recommended (Alchemy): https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Recommended (Infura): https://polygon-mainnet.infura.io/v3/YOUR_KEY
RPC_URL=https://polygon-rpc.com

# =============================================================================
# FORECAST PROVIDER (Optional — agent abstains/NO_TRADE when unset)
# Any OpenAI-compatible endpoint: OpenAI, 9Router, FreeLLMAPI, Ollama, vLLM.
# =============================================================================
# POLYROOT_FORECAST_PROVIDER=openai
# POLYROOT_FORECAST_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# OBSERVABILITY (Optional — /metrics disabled when the key is unset)
# Serves GET /metrics (Bearer key) + GET /healthz (public) on one port.
# =============================================================================
# POLYROOT_METRICS_OWNER_KEY=your-owner-key-here
# POLYROOT_METRICS_HOST=127.0.0.1
# POLYROOT_METRICS_PORT=9090

# =============================================================================
# LOGGING (Optional)
# =============================================================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# ADVANCED (Optional — defaults are safe to keep)
# =============================================================================
# Unix socket for the strategy sandbox supervisor
# STRATEGY_RPC_ENDPOINT=unix:///run/strategy/strategy.sock

# Disable SSL verification for local DB (dev only)
# PGSSLMODE=disable

# Force color output in logs
# FORCE_COLOR=1
