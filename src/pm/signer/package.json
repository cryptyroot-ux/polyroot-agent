{
  "name": "@polyroot/signer",
  "version": "1.14.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "node -e \"console.log('no package-scoped tests yet — see tests/pm')\"",
    "test:contract": "node -e \"console.log('no package-scoped tests yet — see tests/pm')\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polyroot/domain": "*"
  },
  "devDependencies": {
    "@polyroot/tsconfig": "*",
    "@types/node": "^20.19.0",
    "typescript": "^5.5.0"
  }
}
