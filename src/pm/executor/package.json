{
  "name": "@polyroot/executor",
  "version": "1.11.5",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "node -e \"console.log('no package-scoped tests yet — see tests/pm')\"",
    "test:unit": "node -e \"console.log('no package-scoped tests yet — see tests/pm')\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polyroot/domain": "*",
    "@polyroot/risk": "*",
    "@polyroot/signer": "*",
    "@polyroot/venue": "*",
    "zod": "^3.22.4",
    "decimal.js": "^10.4.3"
  },
  "devDependencies": {
    "@polyroot/tsconfig": "*",
    "@types/node": "^26.6.3",
    "typescript": "^5.5.0"
  }
}
