{
  "name": "@polyroot/control",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "node --test --import tsx --import ../../../tests/helpers/test-setup.ts tests/pm/control/**/*.test.ts",
    "test:unit": "npm run test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polyroot/domain": "workspace:*",
    "@polyroot/executor": "workspace:*",
    "@polyroot/ledger": "workspace:*",
    "express": "^5.2.1",
    "zod": "^3.22.4",
    "pino": "^8.18.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@polyroot/tsconfig": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "typescript": "^5.5.0"
  }
}
