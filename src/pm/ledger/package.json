{
  "name": "@polyroot/ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "node -e \"console.log('no package-scoped tests yet \u2014 see tests/pm')\"",
    "test:unit": "node -e \"console.log('no package-scoped tests yet \u2014 see tests/pm')\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polyroot/domain": "*",
    "pg": "^8.17.0",
    "drizzle-orm": "^0.45.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@polyroot/tsconfig": "*",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.5.0"
  }
}
